ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3001

# ── Text-to-speech ──────────────────────────────────────────────
# Which voice engine Jarvis speaks with. Providers sit behind one interface,
# so switching is just this env var — no code changes.
#   browser    = free, uses the browser's built-in Web Speech API (default)
#   cartesia   = cheap, low-latency real voice   (needs CARTESIA_* below)
#   elevenlabs = premium, characterful voice     (needs ELEVENLABS_* below)
TTS_PROVIDER=browser

# Longest reply (chars) spoken aloud by a cloud voice. Longer replies are
# trimmed at a sentence boundary for speech; the full text still shows on
# screen. Prevents synthesis failures on long answers. 0 = no cap. Default 700.
# TTS_MAX_CHARS=700

# ElevenLabs (premium voice — e.g. a designed "British gentleman" Jarvis)
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # any voice id from your library
# ELEVENLABS_MODEL=eleven_flash_v2_5          # low-latency, 0.5 credits/char

# Cartesia (cheap, fast voice)
# CARTESIA_API_KEY=your-cartesia-key
# CARTESIA_VOICE_ID=your-voice-id             # pick one from your Cartesia library
# CARTESIA_MODEL=sonic-2

# ── Speech-to-text ──────────────────────────────────────────────
# Which recognizer transcribes your voice. Providers sit behind one interface,
# so switching is just this env var — no code changes. The wake word ("Hey
# Jarvis") is ALWAYS detected locally and free; only the command itself is sent
# to a cloud recognizer, and only while you're actually speaking (never during
# idle/wake), so you pay for seconds of speech, not hours of silence.
#   browser    = free, uses the browser's built-in Web Speech API (default)
#   soniox     = best value cloud recognizer, strong on accented English
#   assemblyai = strong alternative — bake it off against Soniox on your accent
STT_PROVIDER=browser

# Soniox real-time (~$0.12/hr streamed, semantic endpointing, great WER)
# SONIOX_API_KEY=your-soniox-key
# SONIOX_MODEL=stt-rt-preview

# AssemblyAI Universal-Streaming v3 (~$0.15/hr streamed, explicit turn model).
# Pins the universal-3-5-pro flagship (strong on accented English) by default.
# ASSEMBLYAI_API_KEY=your-assemblyai-key
# ASSEMBLYAI_MODEL=universal-3-5-pro     # current flagship (default)
# ASSEMBLYAI_MODE=balanced               # min_latency | balanced | max_accuracy
# ASSEMBLYAI_PROMPT=Voice assistant commands.   # optional plain-English steering
