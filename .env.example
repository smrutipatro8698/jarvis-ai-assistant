ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3001

# ── Text-to-speech ──────────────────────────────────────────────
# Which voice engine Jarvis speaks with. Providers sit behind one interface,
# so switching is just this env var — no code changes.
#   browser    = free, uses the browser's built-in Web Speech API (default)
#   cartesia   = cheap, low-latency real voice   (needs CARTESIA_* below)
#   elevenlabs = premium, characterful voice     (needs ELEVENLABS_* below)
TTS_PROVIDER=browser

# ElevenLabs (premium voice — e.g. a designed "British gentleman" Jarvis)
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # any voice id from your library
# ELEVENLABS_MODEL=eleven_flash_v2_5          # low-latency, 0.5 credits/char

# Cartesia (cheap, fast voice)
# CARTESIA_API_KEY=your-cartesia-key
# CARTESIA_VOICE_ID=your-voice-id             # pick one from your Cartesia library
# CARTESIA_MODEL=sonic-2
